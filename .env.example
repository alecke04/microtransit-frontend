# Backend API URL (replace with your Railway backend URL)
NEXT_PUBLIC_API_URL=https://your-backend-url.railway.app

# WebSocket URL (replace with your Railway backend WebSocket URL - use wss:// for production)
NEXT_PUBLIC_WS_URL=wss://your-backend-url.railway.app

# Device Configuration (must match backend VALID_API_KEYS_JSON device_id)
NEXT_PUBLIC_DEVICE_ID=TEAM_GPS_01

# API Key (must match backend VALID_API_KEYS_JSON value for the device)
NEXT_PUBLIC_API_KEY=your-secure-api-key-here
