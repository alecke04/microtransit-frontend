# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL (use wss:// for production)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Device configuration
NEXT_PUBLIC_DEVICE_ID=TEAM_GPS_01
# Optional: comma-separated list for tracker rotation in the dashboard UI
# NEXT_PUBLIC_DEVICE_IDS=TEAM_GPS_01,TEAM_GPS_02

# Set true only when backend TESTING=true and mock endpoints are available
NEXT_PUBLIC_USE_MOCK_DATA=false
